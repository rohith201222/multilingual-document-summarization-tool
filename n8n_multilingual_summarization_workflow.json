{
  "name": "Multilingual Summarization Pipeline",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "triggerOn": "specificFolder",
        "folderToWatch": {
          "__rl": true,
          "value": "Document_Uploads_For_Summarization",
          "mode": "list",
          "cachedResultName": "Document_Uploads_For_Summarization"
        },
        "event": "fileCreated"
      },
      "id": "node-google-drive-trigger",
      "name": "Google Drive Trigger",
      "type": "n8n-nodes-base.googleDriveTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "value": "={{ $json.id }}",
          "mode": "id"
        }
      },
      "id": "node-download-file",
      "name": "Download file",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "operation": "pdf",
        "binaryPropertyName": "data"
      },
      "id": "node-extract-from-file",
      "name": "Extract from File",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Detect the primary language of the document.\nReturn only the language name.\nDocument content:\n{{ $json.text }}"
      },
      "id": "node-language-detection",
      "name": "Language Detection",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        860,
        300
      ]
    },
    {
      "parameters": {
        "model": "gemini-2.5-flash",
        "options": {}
      },
      "id": "node-chat-model-lang",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        860,
        480
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a multilingual expert summarizer.\nSummarize the content below into a concise, accurate multi-paragraph summary in the below language.\nRemove redundancies and highlight the most important points.\n\nDocument:\n{{ $('Extract from File').item.json.text }}\n\nLanguage:\n{{ $json.text }}\n\nReturn only the summary."
      },
      "id": "node-summarization",
      "name": "Summarization",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "model": "gemini-2.5-flash",
        "options": {}
      },
      "id": "node-chat-model-sum",
      "name": "Google Gemini Chat Model1",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        1120,
        480
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Translate the summary below into ENGLISH.\nEnsure the translation is accurate, professional, and maintains the original meaning.\n\nSummary:\n{{ $('Summarization').item.json.text }}"
      },
      "id": "node-english-translation",
      "name": "English Translation",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        1380,
        300
      ]
    },
    {
      "parameters": {
        "model": "gemini-2.5-flash",
        "options": {}
      },
