          "__rl": true,
          "value": "My Drive",
          "mode": "list",
          "cachedResultName": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "value": "Summary_Folder",
          "mode": "list",
          "cachedResultName": "Summary_Folder"
        },
        "title": "={{ $('Google Drive Trigger').item.json.name }} - Multilingual Summary"
      },
      "id": "node-create-doc",
      "name": "Create a document",
      "type": "n8n-nodes-base.googleDocs",
      "typeVersion": 2,
      "position": [
        1900,
        720
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "documentURL": "={{ $json.id }}",
        "simple": true,
        "actionsUi": {
          "actionFields": [
            {
              "action": "insert",
              "text": "=Document Title: {{ $('Google Drive Trigger').item.json.name }}\nDetected Language: {{ $('Language Detection').item.json.text }}\n\nSummary (English):\n{{ $('English Translation').item.json.text }}\n\nSummary (Hindi):\n{{ $('Hindi Translation').item.json.text }}\n\nSummary (Spanish):\n{{ $('Spanish Translation').item.json.text }}\n\nSummary (French):\n{{ $('French Translation').item.json.text }}\n\nSummary (German):\n{{ $('German Translation').item.json.text }}\n\nSummary (Japanese):\n{{ $('Japanese Translation').item.json.text }}"
            }
          ]
        }
      },
      "id": "node-update-doc",
      "name": "Update a document",
      "type": "n8n-nodes-base.googleDocs",
      "typeVersion": 2,
      "position": [
        2120,
        720
      ]
    }
